            "url": { "raw": "{{baseUrl}}/api/v1/onboarding/login/handoff", "host": ["{{baseUrl}}"], "path": ["api", "v1", "onboarding", "login", "handoff"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<from otp/verify or refresh>\",\n  \"deviceInfo\": {\n    \"platform\": \"android\"\n  }\n}" }
          },
          "response": []
        },
        {
          "name": "Refresh access token",
          "event": [],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "name": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/v1/onboarding/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "onboarding", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<refresh token>\"\n}" }
          },
          "response": []
        },
        {
          "name": "Check existing user",
          "event": [],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "name": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/v1/onboarding/check-existing-user", "host": ["{{baseUrl}}"], "path": ["api", "v1", "onboarding", "check-existing-user"] },
            "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"+919120000000\"\n}" }
          },
          "response": []
        }
      ]
    }
  ]
}