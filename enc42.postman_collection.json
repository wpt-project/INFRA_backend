            "body": { "mode": "raw", "raw": "{\n  \"phoneNumber\": \"+919120000000\",\n  \"legalVersion\": \"1.1\"\n}" }
          },
          "response": []
        },
        {
          "name": "Send OTP",
          "event": [],
