PORT=4000
DATABASE_URL=
JWT_SECRET=
# Separate secret for the Admin Dashboard (LOGIN-3.10). Never reuse JWT_SECRET.
# Generate with: openssl rand -base64 32
DASHBOARD_JWT_SECRET=
CORS_ORIGIN=http://localhost:3000

# SMS delivery (optional). If unset, the OTP is printed to the server console
# as a dev fallback instead of being sent as a real SMS.
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
