PORT=4000
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000

# Contact hash global salt (required for DB-2.3 privacy-preserving contact matching)
# Generate with: openssl rand -hex 32
# Supports both GLOBAL_SALT (per spec) and CONTACT_HASH_SALT (implementation name)
GLOBAL_SALT=
# CONTACT_HASH_SALT=  # Alternative name, GLOBAL_SALT takes precedence

# SMS delivery (optional). If unset, the OTP is printed to the server console
# as a dev fallback instead of being sent as a real SMS.
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
