PORT=4000
DATABASE_URL=
JWT_SECRET=
# Separate secret for the Admin Dashboard (LOGIN-3.10). Never reuse JWT_SECRET.
# Generate with: openssl rand -base64 32
DASHBOARD_JWT_SECRET=
CORS_ORIGIN=http://localhost:3000

# Supabase Storage — used by the ENC-4.5 group-icon signed-URL endpoint.
# SUPABASE_URL is the project URL, e.g. https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the SECRET "service_role" JWT from
# Dashboard -> Project Settings -> API (starts with `eyJ...`). Do NOT paste a
# publishable/anon key here — those start with `sb_publishable_` and will be
# rejected with "Invalid Compact JWS".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMS delivery (optional). If unset, the OTP is printed to the server console
# as a dev fallback instead of being sent as a real SMS.
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
